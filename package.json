{
  "name": "@radkode/neo",
  "version": "1.8.1",
  "description": "Modern CLI toolkit with intelligent git workflows and configuration management",
  "author": "Jacek Radko",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "neo": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "templates"
  ],
  "keywords": [
    "cli",
    "typescript",
    "commander",
    "radkode",
    "terminal",
    "command-line"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radkode/neo.git"
  },
  "bugs": {
    "url": "https://github.com/radkode/neo/issues"
  },
  "homepage": "https://github.com/radkode/neo#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run build && changeset publish",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "link-local": "pnpm run build && pnpm link --global",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "release": "pnpm run build && pnpm run test && changeset publish",
    "start": "node dist/cli.js",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test": "vitest run",
    "unlink-local": "pnpm unlink --global @radkode/neo",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "find-up": "^8.0.0",
    "nanoid": "^5.1.6",
    "ora": "^9.4.1",
    "which": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/which": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^2.5.20",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
